# Optional Python Beta AI settings; the visible Chrome progress demo needs no key.
# Copy to .env and fill values locally. Never commit real credentials.
# OPENAI_API_KEY or the legacy GPT-API name is accepted; use only one.
OPENAI_API_KEY=
# Project default; select a model available to your API account.
OPENAI_MODEL=gpt-6-astra
OPENAI_BASE_URL=https://api.openai.com/v1
